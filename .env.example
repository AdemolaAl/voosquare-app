# Every environment variable VooSquare reads. On Railway, paste the lines you need into Variables → Raw Editor.

# --- Required ---
# Your email. This account becomes the owner the first time it logs in.
OWNER_EMAIL=you@zedapex.com
# A long random string (signs login codes, unsubscribe links and tool access tokens). Generate: openssl rand -hex 32
# Set it once and keep it. If empty, one is generated and stored in the database.
APP_SECRET=
NODE_ENV=production

# --- Email (codes, welcome series, receipts, support replies) ---
# resend | brevo | postmark. Without these, emails (including login codes) print to the logs instead of sending.
# Admin → Settings → Email can also set these, and wins over the variables.
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=VooSquare <hello@voosquare.com>
EMAIL_REPLY_TO=support@voosquare.com

# --- Teaching voice (VooSquare Academy narration). See docs/VOICE_SETUP.md ---
# ElevenLabs API key (Profile → API keys in ElevenLabs). Needs text to speech and voices read access.
ELEVENLABS_API_KEY=
# Optional second provider.
# OPENAI_API_KEY=
# Where clips are stored. Defaults to a "voice" folder next to the database (so /data/voice on Railway).
# VOICE_DIR=/data/voice

# --- Affiliate program (docs/AFFILIATE_DEV_GUIDE.md) ---
# Telegram alerts bot for affiliates (from @BotFather). Without it the dashboard shows "not configured"; everything else works.
# TELEGRAM_BOT_TOKEN=
# Optional: the bot's username (read with getMe otherwise) and the webhook secret (derived from APP_SECRET otherwise).
# TELEGRAM_BOT_USERNAME=VooSquareAffiliatesBot
# TELEGRAM_WEBHOOK_SECRET=
# KYC and payout provider keys are set in the admin (affiliate Program settings), not here.
# Where the "Affiliates" menu links point once affiliate.voosquare.com is live (default: /affiliates on this host).
# AFFILIATE_URL=https://affiliate.voosquare.com

# --- VooSquare Academy's own website (docs/DEPLOY-GUIDE.md, Part 6b) ---
# Same service, extra domain. voosquareacademy.com and www.voosquareacademy.com always show the academy; add more hosts here.
# ACADEMY_HOSTS=academy-staging.up.railway.app
# Its public address (links, canonical, sitemap, one-tap switch; certificate verify links once set). Default below.
# ACADEMY_URL=https://voosquareacademy.com
# Where the academy sends people for the rest of VooSquare. Default: BASE_URL.
# VOOSQUARE_URL=https://voosquare.com

# --- Usually leave unset on Railway ---
# Your public address, no trailing slash. On Railway it is filled from RAILWAY_PUBLIC_DOMAIN; set it for a custom domain.
# BASE_URL=https://voosquare.com
# Database file. Found automatically from the volume (RAILWAY_VOLUME_MOUNT_PATH, or /data): /data/voosquare.db
# DATABASE_PATH=/data/voosquare.db
# Shared images. Defaults to an "uploads" folder next to the database (so /data/uploads on Railway).
# UPLOADS_DIR=/data/uploads
# Port to listen on. Railway sets it; locally the default is 3000.
# PORT=3000

# --- Security and server limits (docs/DEPLOY-GUIDE.md, section 4.3). The defaults are right for most setups ---
# How many proxies in front of VooSquare add the visitor's address to X-Forwarded-For. Default: 1 on Railway, 0 elsewhere.
# Railway alone: leave unset (1). A CDN such as Cloudflare in front of Railway: 2. No proxy at all: 0.
# Never set it higher than the real number of proxies, or visitors can fake their address (rate limits, fraud checks).
# TRUST_PROXY=2
# A secret for /healthz details. Without it /healthz only says ok. Send the header "X-Health-Key: <this>" to see the
# database and migration state (the owner sees them when logged in). Generate: openssl rand -hex 24
# HEALTH_KEY=
# How long a visitor may take to send one request, in milliseconds (default 120000 = 2 minutes). Live updates are not affected.
# REQUEST_TIMEOUT_MS=120000
# Most live-update connections allowed open at once: per visitor address, per member and for the whole server (defaults 40 / 12 / 5000).
# STREAM_MAX_PER_IP=40
# STREAM_MAX_PER_USER=12
# STREAM_MAX_TOTAL=5000

# --- Upgrades, backups and restores (docs/CHANGING-SAFELY.md, section 15). Leave unset normally ---
# Where database copies go. Defaults to a "backups" folder next to the database (so /data/backups on Railway).
# BACKUPS_DIR=/data/backups
# How many "before an update" copies to keep (default 3).
# PRE_MIGRATE_KEEP=3
# 1/0: a safety copy on every new code version even without a migration (default: on in production).
# BACKUP_ON_DEPLOY=1
# Emergency only, remove right after: allow migrations even when the safety copy fails.
# MIGRATE_WITHOUT_BACKUP=1
# Put a backup back on the next start (a file name from Admin → Settings → Backups). Remove it afterwards.
# RESTORE_FROM=pre-migrate-v3-2026-10-05-090000-000.db
# On staging or a local copy of production data: no emails, no affiliate jobs.
# SAFE_COPY=1

# --- Local testing only, never in production ---
# Lets payment API calls reach localhost/private addresses (for a local Gatevoo or mock provider).
# ALLOW_PRIVATE_OUTBOUND=1
# Shows the login code in the reply instead of emailing it, for local development. Works only on a local address
# (localhost, 127.0.0.1, *.test); on a public address without an email provider the server refuses to start.
# DEV_LOGIN_CODES=1
